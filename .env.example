# Zendesk API Configuration
#
# Prefer the OS keychain over plaintext for the API key:
#   zendesk auth set zendesk            # hidden prompt
#   pbpaste | zendesk auth set zendesk --stdin
#   zendesk auth migrate                # copy an existing .env key into the keychain
# A value here (or in the environment) still overrides the keychain, so delete
# ZENDESK_API_KEY from this file after migrating.

# OAuth token, or: you@example.com/token:your_api_token
ZENDESK_API_KEY=
ZENDESK_BASE_URL=https://your-subdomain.zendesk.com

# Set to 0 to skip the OS keychain lookup (CI, headless Linux). Honored from the
# environment, this file, or the file named by ZENDESK_DOTENV_PATH.
# ZENDESK_KEYCHAIN=0
